# The workflow plugin marketplace is its own repository (ledgry/claude) that
# happens to live in this folder. It is not part of this project and must not
# be committed into it, as a submodule or otherwise.
claude/

# Dependencies
node_modules/

# Build output. `viewable/index.html` is the source of truth; everything
# below is regenerated from it by the scripts in README-BUILD.md, and a
# committed copy is a copy that drifts.
client-site/Paul_Chege_Financial_Advisory_Website/
client-site/build/
client-site/.tw.css

# `client-site/viewable/js/` is NOT ignored, though it is generated. The
# site is static and can be deployed by copying `viewable/` to any host;
# without these three bundles that deployment silently loses the smooth
# scroll, the hero shader and the WebGL book, and degrades to the CSS
# fallbacks with no error anywhere. A build step that is easy to forget is
# not worth a broken deployment.
*.zip

# Runtime state, not source. The booking and order stores are written by the
# server as people use it; committing them publishes test bookings and makes
# every run a merge conflict.
paul-chege-tv/server/data/*.json

# Secrets. Every integration reads its credentials from the environment.
.env
.env.*
!.env.example

# Local noise
*.log
.DS_Store
__pycache__/
.venv/
