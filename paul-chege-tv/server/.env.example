# ─────────────────────────────────────────────────────────────────────────
#  Paul Chege Consultancy TV — payment server
#  Copy to `.env` and fill in. Never commit the filled-in copy.
# ─────────────────────────────────────────────────────────────────────────

# Where Safaricom lives.
#   local emulator  http://localhost:4400          (npm run mock)
#   sandbox         https://sandbox.safaricom.co.ke
#   production      https://api.safaricom.co.ke
MPESA_BASE=http://localhost:4400

# From your Daraja app at https://developer.safaricom.co.ke → My Apps.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# The till or paybill the money lands in — Paul's own, so it reaches him
# directly. Sandbox uses 174379.
MPESA_SHORTCODE=

# Lipa na M-Pesa Online passkey. Sandbox's is on the Daraja test-credentials
# page; production's is issued with the Go-Live approval.
MPESA_PASSKEY=

# Paybill  → CustomerPayBillOnline   (PARTY_B = the paybill number)
# Till/Buy → CustomerBuyGoodsOnline  (PARTY_B = the HEAD OFFICE number,
#                                     which is not the same as the till)
MPESA_TX_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=

# The public HTTPS address of THIS server. Safaricom posts the result here,
# so it must be reachable from the internet — localhost will never work.
# Testing: `npx localtunnel --port 4300` or `cloudflared tunnel --url ...`
PUBLIC_URL=http://localhost:4300

# Browsers allowed to call the API.
ALLOWED_ORIGINS=http://localhost:4180,http://localhost:4190,http://localhost:5173

# The file a buyer receives. Put the real PDF somewhere outside the web root
# — it must never be reachable except through a paid-for download token.
EBOOK_PATH=./server/assets/anatomy-of-smart-borrowing.pdf
EBOOK_FILENAME=The Anatomy of Smart Borrowing — Paul Chege.pdf

# How long a download link lives, and how many times it may be used.
DOWNLOAD_TTL_HOURS=72
DOWNLOAD_MAX=6

# Optional: emails the buyer a receipt with a spare download link.
WEB3FORMS_KEY=
RECEIPT_REPLY_TO=info@bizsure.co.ke

PORT=4300

# ── The diary ───────────────────────────────────────────────────────────
SLOT_TIMES=10:00,11:30,14:00,15:30
HOLD_MINUTES=10
BOOKING_LEAD_HOURS=12
BOOKING_DAYS=12

# Shown to the client BEFORE the prompt, so the name on their handset is one
# they were told to expect. This is the single most useful anti-fraud signal
# you can give a Kenyan buyer — make sure it matches the shortcode's
# registered name exactly.
PAYEE_NAME=Bizsure Insurance Brokers
IRA_LICENCE=
OFFICE_PHONE=+254 710 890 994
OFFICE_ADDRESS=Ciata City Mall, Block A, 2nd Floor, Ridgeways, Kiambu Road, Nairobi

# ── Google Meet ─────────────────────────────────────────────────────────
# Optional. Without it a booking still confirms and Paul phones the client;
# with it, every session gets a real Meet room, lands in Paul's calendar,
# and Google emails the client the invite itself.
#
#   1. console.cloud.google.com → new project → enable "Google Calendar API"
#   2. OAuth consent screen: External, add scope
#      https://www.googleapis.com/auth/calendar.events, then PUBLISH it
#      (leaving it in "Testing" expires the refresh token after 7 days)
#   3. Credentials → OAuth client ID → Web application
#      Authorised redirect URI: http://localhost:4310/callback
#   4. Put the id and secret below, then run:  npm run google:auth
#      Sign in as PAUL — the calendar is whoever consents.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Local emulator (npm run mock:google):
# GOOGLE_OAUTH_BASE=http://localhost:4500
# GOOGLE_CALENDAR_BASE=http://localhost:4500/calendar/v3

# ── Rate limits ─────────────────────────────────────────────────────────
# Kenyan mobile traffic shares IPs behind carrier NAT, so the per-IP cap is
# loose by design — it only has to stop a script. The per-PHONE cap is the
# one that matters: it is what stops someone using Paul's shortcode to spam
# STK prompts at a stranger's handset.
RATE_IP_MAX=240
RATE_PHONE_MAX=5
RATE_WINDOW_MS=600000

# ── Email ───────────────────────────────────────────────────────────────
# Receipts, booking confirmations and reminders. Optional: without it the
# site still works and the client still sees everything on screen.
#
# NOTE: Web3Forms is a NOTIFICATION relay — it delivers to the account
# owner's inbox whatever address you put in the payload, so it cannot send a
# receipt TO a buyer. Use a transactional provider:
#   resend     api key from resend.com          (simplest)
#   brevo      api key from brevo.com           (generous free tier)
#   postmark   server token from postmarkapp.com
#   mailersend api token from mailersend.com
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=hello@paulchege.co.ke
EMAIL_FROM_NAME=Paul Chege Consultancy TV
EMAIL_REPLY_TO=info@bizsure.co.ke
# Paul's own blind copy of every client email:
EMAIL_BCC=
# Where the "new booking" notice goes:
DESK_EMAIL=

# Local emulator (npm run mock:email):
# EMAIL_PROVIDER=resend
# EMAIL_API_BASE=http://localhost:4600
# EMAIL_API_KEY=anything

# ── YouTube ─────────────────────────────────────────────────────────────
# Live view counts, durations and publish dates for the episodes section.
# Optional: without it the page shows the figures baked into the HTML.
#
#   console.cloud.google.com → enable "YouTube Data API v3"
#   → Credentials → Create credentials → API key
#   → Restrict it: API restrictions = YouTube Data API v3,
#     Application restrictions = IP addresses (this server)
#
# THE KEY NEVER GOES IN THE PAGE. The browser calls /api/episodes on this
# server, which holds the key. A key shipped to the browser can be used by
# anyone until it is rotated, and the quota it burns is Paul's.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@paulchege91
# One request covers all the episodes and costs 1 of the 10,000 daily units,
# so this is about not repeating it per visitor, not about speed.
YOUTUBE_CACHE_MINUTES=180

# Local emulator (npm run mock:youtube):
# YOUTUBE_API_BASE=http://localhost:4900
